{
  "__inputs": [
    {
      "name": "DS_MYSQL",
      "label": "Fonte MySQL da estufa",
      "description": "",
      "type": "datasource",
      "pluginId": "mysql",
      "pluginName": "MySQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "13.2.4"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "state-timeline",
      "name": "State timeline",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Painel da estufa CCM520; requer datasource MySQL ligado ao banco fei.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Temperatura e umidade do ar",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT CAST(recvTime AS DATETIME(3)) AS time, CAST(attrValue AS DECIMAL(6,1)) AS value, 'Temperatura' AS metric FROM estufajpmonti WHERE attrName = 'temperature' AND entityId = 'urn:ngsi-ld:Greenhouse:estufajpmonti01' AND $__timeFilter(recvTime) ORDER BY time",
          "refId": "A",
          "type": "mysql"
        },
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT CAST(recvTime AS DATETIME(3)) AS time, CAST(attrValue AS DECIMAL(6,1)) AS value, 'Umidade do ar' AS metric FROM estufajpmonti WHERE attrName = 'relativeHumidity' AND entityId = 'urn:ngsi-ld:Greenhouse:estufajpmonti01' AND $__timeFilter(recvTime) ORDER BY time",
          "refId": "B",
          "type": "mysql"
        }
      ]
    },
    {
      "id": 2,
      "title": "Umidade do solo",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT CAST(recvTime AS DATETIME(3)) AS time, CAST(attrValue AS DECIMAL(6,1)) AS value, 'Solo' AS metric FROM estufajpmonti WHERE attrName = 'soilMoisture' AND entityId = 'urn:ngsi-ld:Greenhouse:estufajpmonti01' AND $__timeFilter(recvTime) ORDER BY time",
          "refId": "A",
          "type": "mysql"
        }
      ]
    },
    {
      "id": 3,
      "title": "Estado do rele",
      "type": "state-timeline",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "string",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "table",
          "rawSql": "SELECT CAST(recvTime AS DATETIME(3)) AS time, IF(attrValue='1','Ligado','Desligado') AS state FROM estufajpmonti WHERE attrName='relayState' AND entityId='urn:ngsi-ld:Greenhouse:estufajpmonti01' AND $__timeFilter(recvTime) ORDER BY time",
          "refId": "A",
          "type": "mysql"
        }
      ]
    },
    {
      "id": 4,
      "title": "Luminosidade atual",
      "type": "stat",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "table",
          "rawSql": "SELECT CAST(attrValue AS DECIMAL(6,1)) AS value FROM estufajpmonti WHERE attrName='illuminance' AND entityId='urn:ngsi-ld:Greenhouse:estufajpmonti01' ORDER BY CAST(recvTimeTs AS UNSIGNED) DESC LIMIT 1",
          "refId": "A",
          "type": "mysql"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "CCM520",
    "FIWARE"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
